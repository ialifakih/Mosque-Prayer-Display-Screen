#MOSQUE_API_ENDPOINT=https://api.mosque.tech/mosque-data/YOUR_SPREADSHEET_ID # Google sheets version
MOSQUE_API_ENDPOINT=http://localhost:3000/api/example-mosque

# Add your brand colors
THEME_COLOR_HIGHLIGHT=#C6A15B
THEME_COLOR_PRIMARY=#0B3D2E
THEME_COLOR_PRIMARY_ALT=#072F25
THEME_COLOR_ON_PRIMARY=#FFF8E7
THEME_COLOR_ON_PRIMARY_ALT=#FFF8E7
# Change local for date time in different locale
LOCALE=en

# Admin Screen config
ADMIN_GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n******\n-----END PRIVATE KEY-----\n"
ADMIN_GOOGLE_SA_EMAIL=XXXX@XXXX-XXXX.iam.gserviceaccount.com
SPREADSHEET_ID=YOUR_SPREADSHEET_ID

AUTH_USERNAME=myuser
AUTH_PASSWORD=secret
AUTH_SECRET=some-long-random-string
