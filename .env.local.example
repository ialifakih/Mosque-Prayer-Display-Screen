#MOSQUE_API_ENDPOINT=https://api.mosque.tech/mosque-data/YOUR_SPREADSHEET_ID # Google sheets version
MOSQUE_API_ENDPOINT=http://localhost:3000/api/example-mosque

# Add your brand colors
THEME_COLOR_HIGHLIGHT=#C6A15B
THEME_COLOR_PRIMARY=#0B3D2E
THEME_COLOR_PRIMARY_ALT=#072F25
THEME_COLOR_ON_PRIMARY=#FFF8E7
THEME_COLOR_ON_PRIMARY_ALT=#FFF8E7
# Change local for date time in different locale
LOCALE=en

# Google Sheets admin access
# Preferred: paste the complete Google service-account JSON as one value.
ADMIN_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
# Legacy fallback only (do not need these when the JSON variable above is set):
# ADMIN_GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n******\n-----END PRIVATE KEY-----\n"
# ADMIN_GOOGLE_SA_EMAIL=XXXX@XXXX-XXXX.iam.gserviceaccount.com
SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# Admin login
AUTH_USERNAME=myuser
AUTH_PASSWORD=secret
# Required in production. Use one stable random value and keep it unchanged across redeploys.
AUTH_SECRET=some-long-random-string
# NEXTAUTH_SECRET is also accepted as a compatibility fallback.
# NEXTAUTH_SECRET=some-long-random-string

# Required when Google OAuth is enabled; comma-separated and case-insensitive.
ADMIN_ALLOWED_EMAILS=admin@example.com
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
